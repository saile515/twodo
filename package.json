{
    "name": "twodo",
    "version": "0.0.8",
    "description": "A minimal data-oriented 2D WebGL engine.",
    "author": "Elias Jörgensen",
    "license": "MIT",
    "homepage": "https://github.com/saile515/twodo#readme",
    "bugs": {
        "url": "https://github.com/saile515/twodo/issues"
    },
    "keywords": [
        "2D",
        "WebGL",
        "Engine"
    ],
    "files": [
        "./build/*"
    ],
    "exports": {
        "import": "./build/twodo.mjs",
        "types": "./build/twodo.d.ts"
    },
    "scripts": {
        "build": "tsc && vite build",
        "docs:dev": "vitepress dev docs",
        "docs:build": "typedoc && vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "repository": "git+https://github.com/saile515/twodo.git",
    "devDependencies": {
        "@types/node": "^25.5.0",
        "gl-matrix": "^3.4.4",
        "typedoc": "^0.28.18",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.3",
        "vite-plugin-dts": "^4.5.4",
        "vitepress": "^1.6.4"
    }
}
